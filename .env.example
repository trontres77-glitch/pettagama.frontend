# ============================================================
# PETTAGAMA.LK - ENVIRONMENT VARIABLES (PostgreSQL Edition)
# Copy this file to .env.local for local development
# Set these in Railway dashboard for production
# ============================================================

# PostgreSQL Connection (Railway provides this automatically)
DATABASE_URL=postgresql://USER:PASSWORD@HOST:PORT/DATABASE

# JWT Secret
JWT_SECRET=your_super_secret_jwt_key_change_this_in_production_minimum_32_chars

# WhatsApp Business Number (Sri Lanka: 94XXXXXXXXX)
NEXT_PUBLIC_WHATSAPP_NUMBER=94712345678

# Site URL
NEXT_PUBLIC_SITE_URL=https://pettagama.lk

# Admin Default Credentials
ADMIN_EMAIL=admin@pettagama.lk
ADMIN_PASSWORD=Admin@Pettagama2024!

# Node Environment
NODE_ENV=production
